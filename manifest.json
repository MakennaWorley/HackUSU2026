{
	"name": "Good Griff",
	"description": "Focus mode that blocks distracting sites.",
	"version": "0.1.0",
	"manifest_version": 3,
	"action": {
		"default_popup": "dist/frontend/popup.html",
		"default_title": "Good Griff"
	},
	"background": {
		"service_worker": "dist/backend/service_worker.js"
	},
	"permissions": ["tabs", "storage", "alarms"],
	"host_permissions": ["<all_urls>"],
	"icons": {
		"16": "assets/griff.png"
	}
}
